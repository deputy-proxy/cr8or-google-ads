GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# Optional manager account used to access the customer account.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
MCP_AUTH_TOKEN=

# MCP OAuth broker configuration.
# GOOGLE_OAUTH_CLIENT_ID/SECRET are the Google OAuth web application credentials
# whose redirect URI is https://cr8or-google-ads-production.up.railway.app/oauth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_SIGNING_SECRET=
# Comma-separated Google email addresses allowed to authorize the MCP server.
OAUTH_ALLOWED_EMAILS=
# Optional; defaults to the production Railway origin shown above.
OAUTH_ISSUER=https://cr8or-google-ads-production.up.railway.app

PORT=3000
